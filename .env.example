# --- Core (Payload) ---
PAYLOAD_ENABLED=true
PAYLOAD_SECRET=
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# --- Neon (for `pnpm db:branch` / `pnpm db:reset`) ---
# Find via `pnpm exec neonctl projects list`
NEON_PROJECT_ID=

# --- Site ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# --- Instagram ---
# Bootstrap only. The live token rotates every 60 days and is stored in the
# `instagram-auth` global, which the daily refresh job writes; this value is what
# the job starts from on a fresh database, and the fallback until it first runs.
# Pasting a new one here has no effect while the global holds a working token.
INSTAGRAM_TOKEN=

# --- Jobs ---
# Shared secret for `/api/payload-jobs/run`. Vercel's cron sends it as
# `Authorization: Bearer $CRON_SECRET`; with it unset the endpoint requires an
# admin session instead, so it is never open.
CRON_SECRET=

# --- Alerts ---
# Where the developer is emailed when the Instagram token refresh fails three
# days running. Not Luiza's address: there is nothing she can do about a token.
# Without this (or without RESEND_API_KEY) the alert falls back to console.error.
ALERT_EMAIL_TO=
