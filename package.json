{
  "name": "luiza-psi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "payload generate:importmap && payload generate:types && payload migrate && next build",
    "start": "next start",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "oxlint --threads=2 src/",
    "format": "oxfmt --write src/ '!src/payload-types.ts'",
    "format:check": "oxfmt --check src/ '!src/payload-types.ts'",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cosmos:textures": "tsx scripts/cosmos-textures.ts",
    "db:branch": "tsx --env-file=.env.local scripts/db-branch.ts",
    "db:reset": "tsx --env-file=.env.local scripts/db-reset.ts",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:migrate:status": "payload migrate:status",
    "seed": "tsx --require ./scripts/no-schema-push.cjs --env-file .env.local src/payload/seed/index.ts",
    "export:content": "tsx --require ./scripts/no-schema-push.cjs --env-file .env.local scripts/export-content.mts",
    "prepare": "husky"
  },
  "dependencies": {
    "@payloadcms/db-vercel-postgres": "3.78.0",
    "@payloadcms/next": "3.78.0",
    "@payloadcms/richtext-lexical": "3.78.0",
    "@payloadcms/storage-vercel-blob": "3.78.0",
    "@payloadcms/translations": "3.78.0",
    "@react-three/fiber": "^9.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "graphql": "^16.13.0",
    "lexical": "^0.35.0",
    "next": "16.1.6",
    "payload": "3.78.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "three": "^0.180.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@typescript/native-preview": "7.0.0-dev.20260227.1",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "neonctl": "^2.22.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
